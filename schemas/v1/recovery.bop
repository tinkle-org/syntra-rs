// Required fields are positional. Check profileVersion before dispatch.
struct Negotiate {
    uint32 profileVersion;
    uint32 minVersion;
    uint32 maxVersion;
    string capability;
}
struct Negotiated {
    uint32 profileVersion;
    uint32 selectedVersion;
    uint32 maxSubscriptionsPerConnection;
    uint32 maxPendingRpcsPerConnection;
    uint32 maxPageBytes;
    uint32 maxSnapshotPages;
}
struct Subscribe {
    uint32 profileVersion;
    byte[] streamSelector;
    byte[] startCheckpoint;
}
struct SubscriptionAccepted {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
    byte[] catchupBoundary;
}
struct Unsubscribe {
    uint32 profileVersion;
    byte[] subscriptionHandle;
}
struct Unsubscribed {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
}
struct Replay {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    byte[] fromCheckpoint;
    uint32 maxBatches;
    uint32 maxBytes;
    byte[] continuationMarker;
}
struct RecoveryReplayPage {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    byte[] predecessorCheckpoint;
    byte[] resultCheckpoint;
    byte[] continuationMarker;
    byte[] catchupBoundary;
    // Packed sequence to EOF: u32 little-endian byte length + serialized
    // RecoveryBatch per entry. Check each length, the 64-entry limit and
    // the total payload budget before copying; no wire allocation count.
    byte[] batchPayloads;
}
struct RecoveryReplayComplete {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
    byte[] liveBoundaryCheckpoint;
}
struct CatchUp {
    uint32 profileVersion;
    byte[] subscriptionHandle;
}
struct RecoveryCatchUpAccepted {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
    byte[] catchupBoundary;
}
struct OfferSnapshot {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
}
struct RecoverySnapshotDescriptor {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    byte[] snapshotHandle;
    byte[] boundaryCheckpoint;
    uint32 totalPages;
    uint32 pageBytesMax;
}
struct FetchSnapshot {
    uint32 profileVersion;
    byte[] snapshotHandle;
    uint32 pageIndex;
}
struct RecoverySnapshotChunk {
    uint32 profileVersion;
    byte[] snapshotHandle;
    uint32 pageIndex;
    byte[] pageBytes;
    byte[] boundaryCheckpoint;
}
// Local transfer record, not an RPC result or notification arm.
struct RecoverySnapshotComplete {
    uint32 profileVersion;
    byte[] snapshotHandle;
    byte[] boundaryCheckpoint;
    uint32 totalPages;
    uint64 totalBytes;
}
struct RecoverySnapshotInstalled {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    byte[] boundaryCheckpoint;
    uint64 generation;
}
struct Confirm {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
    byte[] checkpoint;
}
struct ConfirmSnapshot {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
    byte[] boundaryCheckpoint;
}
struct Confirmed {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    byte[] confirmedCheckpoint;
    uint64 generation;
}
struct RecoveryBatch {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
    byte[] predecessorCheckpoint;
    byte[] resultCheckpoint;
    byte[] batchPayload;
}
struct RecoveryBatchTrailer {
    uint32 profileVersion;
    byte[] subscriptionHandle;
    uint64 generation;
    byte[] boundaryCheckpoint;
    TrailerOutcome outcome;
    byte[] terminateReason;
}
union TrailerOutcome {
    5 -> struct NextGeneration { uint64 value; }
    6 -> struct CatchupComplete {}
    7 -> struct SnapshotRequired {}
    8 -> struct Terminated {}
}
struct RecoveryNotification {
    uint32 profileVersion;
    RecoveryEvent notification;
}
union RecoveryEvent {
    2 -> struct Batch { RecoveryBatch value; }
    3 -> struct ReplayComplete { RecoveryReplayComplete value; }
    4 -> struct Trailer { RecoveryBatchTrailer value; }
}
